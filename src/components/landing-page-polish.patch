--- a/src/app/globals.css
+++ b/src/app/globals.css
@@
 .landing-shell {
   min-height: 100vh;
   overflow-x: clip;
 }

+/* Landing-page motion: reveal each major section only when it enters view. */
+@media (prefers-reduced-motion: no-preference) {
+  .landing-shell main > section,
+  .landing-shell > footer {
+    opacity: 0;
+    transform: translateY(28px);
+    transition: opacity 720ms cubic-bezier(0.22, 1, 0.36, 1), transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
+  }
+
+  .landing-shell main > section.is-visible,
+  .landing-shell > footer.is-visible {
+    opacity: 1;
+    transform: none;
+  }
+}

+.hero-grid {
+  opacity: 0.34;
+  background-image:
+    linear-gradient(rgba(124, 245, 170, 0.055) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(124, 245, 170, 0.055) 1px, transparent 1px);
+  background-size: 52px 52px;
+  mask-image: radial-gradient(ellipse 78% 68% at 53% 37%, black 0%, transparent 76%);
+  -webkit-mask-image: radial-gradient(ellipse 78% 68% at 53% 37%, black 0%, transparent 76%);
+}

+.hero-ray {
+  height: 1px;
+  width: min(42vw, 540px);
+  opacity: 0;
+  background: linear-gradient(90deg, transparent, rgba(124, 245, 170, 0.92), transparent);
+  box-shadow: 0 0 10px rgba(124, 245, 170, 0.65), 0 0 26px rgba(124, 245, 170, 0.22);
+  animation: hero-ray 9s ease-in-out infinite;
+}

+.hero-ray-one { animation-delay: 1.8s; }
+.hero-ray-two { animation-delay: 6.1s; animation-direction: reverse; }

+@keyframes hero-ray {
+  0%, 68%, 100% { opacity: 0; transform: translateX(-30%); }
+  74% { opacity: 0.86; }
+  82% { opacity: 0; transform: translateX(150%); }
+}

+@media (prefers-reduced-motion: reduce) {
+  .hero-ray { animation: none; }
+}

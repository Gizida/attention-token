# Offerwall.gg placement settings. Keep the secret server-side.
OFFERWALL_GG_PUBLIC_KEY=05985907f4dd93999df0455beb337ae5
OFFERWALL_GG_SECRET_KEY=

# Enable only when expiring links are also enabled for the placement.
OFFERWALL_GG_EXPIRING_LINKS=false

# Server-only Turnkey payout signer. Never prefix these with NEXT_PUBLIC_.
TURNKEY_ORGANIZATION_ID=
TURNKEY_PRIVATE_KEY_ID=
# Accepts either the Base58 Solana address or Turnkey's 64-character hex key.
TURNKEY_SOLANA_PUBLIC_KEY=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# Optional; defaults to https://api.turnkey.com.
# TURNKEY_API_BASE_URL=https://api.turnkey.com

# Use a private server RPC URL in production. The existing public variable is
# accepted as a fallback while migrating.
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK_URL=

# Set this when the provider uses a separate WebSocket endpoint.
# SOLANA_RPC_SUBSCRIPTIONS_URL=

# Withdrawals stay paused until migration, cron, policy, and canary checks pass.
PAYOUTS_ENABLED=false
AUTO_PAYOUTS_ENABLED=false
PAYOUT_BATCH_SIZE=5
CRON_SECRET=

# Server-side SOL/USD quotes.
COINGECKO_API_KEY=
# COINGECKO_API_URL=https://api.coingecko.com/api/v3

# One-time wallet sign-in challenges.
AUTH_DOMAIN=attentiontoken.net
AUTH_ORIGIN=https://attentiontoken.net
JWT_SECRET=

# Comma-separated Solana wallets allowed to review withdrawals.
ADMIN_WALLET_ADDRESSES=

# Operational alerts. Configure Telegram, Resend, or both.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
OPERATIONS_ALERT_EMAIL=
OPERATIONS_ALERT_FROM=Attention Token <alerts@attentiontoken.net>
REVERSAL_SPIKE_THRESHOLD=5

# Controlled beta and abuse controls.
BETA_INVITES_REQUIRED=true
BETA_USER_CAP=50
RISK_HMAC_SECRET=
PAYOUT_ESTIMATED_NETWORK_FEE_USD=0.01
